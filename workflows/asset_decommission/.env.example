# Binalyze AIR — Asset Decommission workflow
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The script searches for .env in this directory first, then falls back to
# the repository root .env, so you can keep credentials here for standalone
# use or rely on the shared repo-root .env for CI / multi-workflow setups.
#
# DO NOT commit .env — it is listed in .gitignore.

# Your AIR tenant URL (no trailing slash)
BINALYZE_AIR_HOST=https://your-tenant.binalyze.com

# API bearer token — generate one in AIR under Integrations > API Tokens.
# The token must have asset management permissions (read assets + uninstall).
BINALYZE_API_TOKEN=api_your_token_here
